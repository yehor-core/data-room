{
  "name": "data-room-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@supabase/supabase-js": "^2.75.1",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18"
  },
  "scripts": {
    "dev": "craco start",
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "test:coverage": "craco test --watchAll=false --coverage",
    "typecheck": "tsc",
    "test:unit": "craco test --watchAll=false --testPathIgnorePatterns \"\\\\.integration\\\\.test\\\\.tsx?$\"",
    "test:integration": "craco test --watchAll=false --testPathPattern \"\\\\.integration\\\\.test\\\\.tsx?$\"",
    "test:e2e": "supabase start --workdir .. && playwright test",
    "e2e:serve": "serve --single --no-clipboard e2e/build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|react-router|react-router-dom|until-async)/).+\\.(js|jsx|cjs|ts|tsx)$"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/setupTests.ts",
      "!src/test/**",
      "!src/**/__tests__/**"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "./src/data/": {
        "lines": 90,
        "branches": 90
      },
      "global": {
        "lines": 80
      }
    }
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "msw": "^2.15.0",
    "react-scripts": "5.0.1",
    "serve": "^14.2.8",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^4.9.5"
  }
}
