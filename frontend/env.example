# --- Frontend Local .env.local ---

# 1. URL вашего локального backend
REACT_APP_API_URL="http://localhost:3001/api"

# 2. Публичные ключи Supabase (они безопасны для frontend)
REACT_APP_SUPABASE_URL="https://[YOUR_SUPABASE_REF].supabase.co"
REACT_APP_SUPABASE_ANON_KEY="[YOUR_SUPABASE_ANON_KEY]" # Публичный ключ (anon key)