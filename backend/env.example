# --- Backend Local .env ---

# 1. База данных (Supabase)
# Прямая ссылка для Prisma (миграции, Studio)
DATABASE_URL="postgresql://postgres.[YOUR_SUPABASE_REF]:[YOUR_DB_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Ссылка с пулером соединений для самого приложения
DIRECT_URL="postgresql://postgres.[YOUR_SUPABASE_REF]:[YOUR_DB_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase API
SUPABASE_URL="https://[YOUR_SUPABASE_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SUPABASE_SERVICE_ROLE_KEY]" # Секретный ключ!

# 3. Настройки приложения
NODE_ENV="development"
PORT="3001" # Порт, на котором будет работать ваш локальный backend
ALLOWED_ORIGINS="http://localhost:3000" # Разрешаем доступ с локального frontend