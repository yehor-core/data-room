# --- Backend Local .env ---

# 1. Database (Supabase)
# Pooled connection (pgbouncer) for the application itself
DATABASE_URL="postgresql://postgres.[YOUR_SUPABASE_REF]:[YOUR_DB_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for Prisma migrations and Studio
DIRECT_URL="postgresql://postgres.[YOUR_SUPABASE_REF]:[YOUR_DB_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# 2. Supabase API
SUPABASE_URL="https://[YOUR_SUPABASE_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SUPABASE_SERVICE_ROLE_KEY]" # Secret key!

# 3. Application settings
NODE_ENV="development"
PORT="3001" # Port for your local backend to run on
ALLOWED_ORIGINS="http://localhost:3000" # Allow access from local frontend
