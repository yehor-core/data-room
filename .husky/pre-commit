if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so staged changes can't be scanned for secrets." >&2
  echo "Install it (https://github.com/gitleaks/gitleaks#installing), e.g. 'brew install gitleaks'," >&2
  echo "or put the release binary on your PATH, then commit again." >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --verbose
npx lint-staged
